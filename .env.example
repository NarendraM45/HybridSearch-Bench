# Ollama (required — run Ollama locally or via Docker)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=hybrid_bench

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval
BM25_TOP_K=10
VECTOR_TOP_K=10
RRF_K=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
