# Ollama (required — run Ollama locally or via Docker)
# Use http://localhost:11434 for local runs; docker-compose overrides this to http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=hybrid_bench

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval
BM25_TOP_K=10
VECTOR_TOP_K=10
RRF_K=60

# Evaluation (ollama = reliable local scoring; ragas = optional, often breaks JSON parsing)
EVAL_BACKEND=ollama
EVAL_TIMEOUT=120

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
